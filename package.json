{
  "name": "artcraft-command-bridge",
  "version": "2.1.0",
  "description": "One compact MCP bridge for the 19 ArtCraft apps: 5 tools instead of 978, on-demand discovery and token-bounded results.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "artcraft",
    "figcraft",
    "photocraft",
    "vectorcraft",
    "lightcraft",
    "designcraft",
    "anicraft",
    "solidcraft",
    "mailcraft",
    "craft-anything",
    "texturecraft",
    "materialcraft",
    "deterministic",
    "cli"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "server.js",
  "bin": {
    "artcraft-command-bridge": "server.js",
    "artcraft-sync-registry": "tools/sync-registry.js"
  },
  "scripts": {
    "sync-registry": "node tools/sync-registry.js",
    "test": "node tools/adapter-contract-test.js && node tools/exec-test.js && node tools/agg-test.js && node tools/token-size-test.js && node tools/output-integration-test.js",
    "test:adapters": "node tools/adapter-contract-test.js",
    "test:exec": "node tools/exec-test.js",
    "test:output": "node tools/output-integration-test.js",
    "test:registry": "node tools/registry-cache-test.js",
    "test:token": "node tools/token-size-test.js"
  },
  "files": [
    "server.js",
    "lib/",
    "skills/",
    "tools/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiewg1987/artcraft-command-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/xiewg1987/artcraft-command-bridge/issues"
  },
  "homepage": "https://github.com/xiewg1987/artcraft-command-bridge#readme"
}
