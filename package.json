{
  "name": "artcraft-command-bridge",
  "version": "1.2.0",
  "description": "One MCP server for the 15 ArtCraft Crafting Apps — 5 tools instead of 871, with list/describe discovery, output truncation, base64 redaction and one-image previews.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "artcraft",
    "figcraft",
    "photocraft",
    "vectorcraft",
    "lightcraft",
    "designcraft",
    "texturecraft",
    "materialcraft",
    "deterministic",
    "cli"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "server.js",
  "bin": {
    "artcraft-command-bridge": "server.js",
    "artcraft-sync-registry": "tools/sync-registry.js"
  },
  "scripts": {
    "sync-registry": "node tools/sync-registry.js",
    "test": "node tools/agg-test.js && node tools/token-size-test.js",
    "test:registry": "node tools/registry-cache-test.js",
    "test:token": "node tools/token-size-test.js"
  },
  "files": [
    "server.js",
    "lib/",
    "tools/sync-registry.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiewg1987/artcraft-command-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/xiewg1987/artcraft-command-bridge/issues"
  },
  "homepage": "https://github.com/xiewg1987/artcraft-command-bridge#readme"
}
